# ==============================================================================
# RivalScope Configuration Template
# ==============================================================================

# --- Environment & Server ---
ENV=development
DEBUG=true
PORT=7777
HOST=0.0.0.0
APP_NAME=RivalScope
APP_VERSION=0.1.0
AGENTOS_URL=http://localhost:7777

# --- Security & Auth ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-for-production
JWT_SECRET=change-me-to-a-secure-jwt-secret-key-for-token-signing
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_MASTER_KEY=change-me-to-32-byte-base64-or-hex-key-for-envelope-enc

# --- Database & Vector Store ---
# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rivalscope
# Dedicated async connection string if used
ASYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rivalscope

# --- Redis & Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Offline / Mock Mode ---
# When true, all external API calls (Tavily, Firecrawl, EDGAR, LLM) use deterministic
# local mock providers. System runs completely offline without any API keys.
MOCK_PROVIDERS=true

# --- LLM Providers ---
# Primary provider: gemini (Google AI Studio), openai, anthropic
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_ai_studio_key
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model assignments (e.g. gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash)
COLLECTOR_MODEL=gemini:gemini-2.0-flash
ANALYST_MODEL=gemini:gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

# --- External Search & Crawl ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEC_EDGAR_USER_AGENT=RivalScope Research team@rivalscope.org

# --- MCP Layer ---
# MCP Server (platform published to Claude/Cursor/ChatGPT)
MCP_SERVER_ENABLED=true
MCP_CONNECT_SECRET=change-me-for-mcp-oauth-connect
MCP_SERVER_CARD_URL=http://localhost:7777/mcp

# MCP Gateway (connecting external company MCP servers)
MCP_ALLOW_PRIVATE_IPS=false
MCP_DEFAULT_TIMEOUT_SECONDS=15
MCP_MAX_TOOL_OUTPUT_CHARS=50000

# --- Scheduling & Delivery ---
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15
DEFAULT_TIMEZONE=UTC

# Slack integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#competitive-intel

# Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Generic Webhook delivery
DEFAULT_WEBHOOK_URL=

# --- Observability & Telemetry ---
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_ENABLED=true
